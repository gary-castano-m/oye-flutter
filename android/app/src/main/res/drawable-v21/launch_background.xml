<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo: lo que Android muestra mientras Flutter arranca (antes de SplashScreen).
     Mismo degradado del ícono con el logo blanco en el centro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#003A52"
                android:endColor="#22A855"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
