<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del ícono adaptativo (versión Flutter, opción D):
     degradado diagonal de azul #003A52 (arriba a la izquierda) a verde #22A855 (abajo a la derecha). -->
