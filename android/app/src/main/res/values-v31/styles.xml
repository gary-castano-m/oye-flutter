<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 en adelante usa su propio splash: el ícono de la app sobre un color
         de fondo (no admite degradados). Se usa el azul de la marca para empalmar con
         el splash de Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#003A52</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
